# FloatChat Environment Configuration Example
# Copy this file to .env and adjust values for your local setup.

# PostgreSQL Database Configuration
HOST_NAME=localhost
DATABASE_NAME=floatchatai
USER_NAME=postgres
PASSWORD=your_postgres_password_here
PORT=5432

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash

# Live Argo Integration Settings
ARGO_LIVE_FETCH=true
ARGO_LOCAL_FALLBACK=true
ARGO_MAX_PROFILES=20
ARGO_ERDDAP_TIMEOUT=30
ARGO_CACHE_TTL_HOURS=24

# Semantic & Proximity Search
FLOATCHAT_TOP_K=3
FLOATCHAT_RADIUS_METERS=50000
